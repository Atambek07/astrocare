# AstroCare environment example

# Backend Brain
ASTROCARE_BACKEND_PORT=8765
ASTROCARE_WS_PORT=8787
ASTROCARE_FRONTEND_PORT=3000

# Doctor Layer. Set to 1 for offline rule-based mode.
ASTRO_DOCTOR_OFFLINE=1

# Local Ollama settings (used only when ASTRO_DOCTOR_OFFLINE != 1)
ASTRO_OLLAMA_URL=http://localhost:11434
ASTRO_OLLAMA_MODEL=qwen2.5:7b-instruct

# Frontend Brain WebSocket
NEXT_PUBLIC_BRAIN_WS_URL=ws://localhost:8787
